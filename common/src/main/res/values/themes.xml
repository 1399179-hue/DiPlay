<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Xcertplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0C111B</item>
        <item name="android:statusBarColor">#0C111B</item>
        <item name="android:windowBackground">#0C111B</item>
        <!-- Without it, API 31+ draws a white splash before the dark Home screen. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#0C111B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Xcertplay.Light">
        <!-- Apple iOS light system: grouped background #F2F2F7, accessible system blue accent. -->
        <item name="android:colorAccent">#0068D6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#F2F2F7</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Dark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:windowBackground">#151E2C</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0068D6</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
    <style name="Theme.AdbCluster" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
